# ── EduStream Frontend Environment Variables ───────────────────────
# In production on Vercel, set VITE_API_URL to your Render backend service URL:
# Example: https://edustream-backend.onrender.com
# NOTE: Do NOT include trailing slash. You can leave it empty in local dev to use the Vite proxy.
VITE_API_URL=https://edustream-backend.onrender.com
