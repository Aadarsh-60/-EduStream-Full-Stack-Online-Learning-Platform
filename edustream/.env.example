# ── EduStream Docker Environment Variables ────────────────────────
# Copy this file to .env and fill in your actual credentials.
# Docker Compose will automatically load these variables.

# ── Database (MongoDB Atlas / External Cloud MongoDB) ───────────
# Use MongoDB Atlas so data persists across redeployments and sleeps
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net

# ── Security & Authentication ────────────────────────────────────
JWT_SECRET=replace_with_strong_secret_32chars
ACCESS_TOKEN_SECRET=replace_with_strong_secret_32chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=replace_with_strong_secret_32chars
INTERNAL_SERVICE_SECRET=edustream_internal_2024

# ── Google OAuth 2.0 ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ── Cloudinary (Media Storage & Video Streaming) ────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# ── Google Gemini AI (EduBot, Notes, Roadmap) ───────────────────
GEMINI_API_KEY=your_gemini_api_key

# ── Razorpay (Payments & Webhooks) ──────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── Notification Hub SDK (Centralized Messaging) ────────────────
NOTIFICATION_HUB_API_KEY=your_notification_hub_api_key
NOTIFICATION_HUB_API_SECRET=your_notification_hub_api_secret

# ── SMTP Email Delivery ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
ADMIN_EMAIL=admin@edustream.com
